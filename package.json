{
  "name": "honeyrail",
  "version": "0.1.0",
  "description": "Open-source runtime for long-horizon, verifiable engineering work.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clemenza/honeyrail.git"
  },
  "bugs": {
    "url": "https://github.com/clemenza/honeyrail/issues"
  },
  "homepage": "https://github.com/clemenza/honeyrail#readme",
  "keywords": [
    "coding-agents",
    "honeyrail",
    "codex",
    "claude-code",
    "control-plane",
    "git-worktree",
    "tmux",
    "mcp",
    "self-hosted",
    "developer-tools",
    "agentic-ai"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "setup": "tsx server/setup.ts",
    "ops:start": "scripts/start.sh",
    "ops:stop": "scripts/stop.sh",
    "ops:restart": "scripts/restart.sh",
    "ops:status": "scripts/status.sh",
    "doctor": "tsx server/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:e2e": "playwright test",
    "mcp": "tsx server/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/headless": "^6.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
