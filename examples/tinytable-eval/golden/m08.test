# Kills m08 (aggregate NULL handling): COUNT(col) must exclude rows where
# col IS NULL, the same way SQL's COUNT(col) does - see SPEC.md's
# "Aggregates" section. A defective COUNT(col) that counts every row
# (i.e. behaves like COUNT(*)) would return 2 here instead of 1.

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (NULL)

query I nosort
SELECT COUNT(x) FROM t
----
1
