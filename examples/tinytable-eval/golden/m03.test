# Kills m03 (index/scan inconsistency): UPDATE must keep every indexed
# column's secondary index in sync with the new value - see SPEC.md's
# "Secondary index" section ("a query against an indexed column must return
# exactly the same rows ... as the same query would against an unindexed
# column"). A defective UPDATE that never refreshes the index would leave a
# stale, superseded entry behind and miss the row under its new value.

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (10)

statement ok
CREATE INDEX idx ON t(x)

statement ok
UPDATE t SET x = 20 WHERE x = 1

query I nosort
SELECT x FROM t WHERE x >= 15
----
20
