# Kills m01 (NULL three-valued logic): `=` must never match when either
# side is NULL, including NULL = NULL - see SPEC.md's "NULL semantics"
# section. A defective `eq` that special-cases NULL = NULL as a match would
# return the NULL row here instead of zero rows.

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (NULL)

statement ok
INSERT INTO t VALUES (1)

query I nosort
SELECT x FROM t WHERE x = NULL
----
