# Kills m04 (sort semantics): ORDER BY ... DESC must be a genuinely stable
# descending sort (tied rows keep insertion order), and NULL placement
# (NULLS FIRST/LAST) must be independent of ASC/DESC - see SPEC.md's
# "ORDER BY" section. A defective implementation that sorts ascending and
# then reverses the whole result would both un-stabilize ties under DESC
# and move the NULL block to the wrong end.

statement ok
CREATE TABLE t (k INTEGER, tag TEXT)

statement ok
INSERT INTO t VALUES (1, 'a')

statement ok
INSERT INTO t VALUES (1, 'b')

query T nosort
SELECT tag FROM t ORDER BY k DESC
----
a
b

statement ok
CREATE TABLE t2 (x INTEGER)

statement ok
INSERT INTO t2 VALUES (2)

statement ok
INSERT INTO t2 VALUES (NULL)

statement ok
INSERT INTO t2 VALUES (1)

query I nosort
SELECT x FROM t2 ORDER BY x DESC NULLS LAST
----
2
1
NULL
