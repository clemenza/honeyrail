# Kills m05 (transaction rollback residue): ROLLBACK TO must restore every
# secondary index's contents together with the rows, so a query against an
# indexed column right after a rollback behaves as if the index were
# rebuilt from scratch - see SPEC.md's "SAVEPOINT / ROLLBACK TO" section. A
# defective rollback that restores rows but not index contents would leave
# the index pointing at the pre-rollback (now stale) value.

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
CREATE INDEX idx ON t(x)

statement ok
SAVEPOINT s1

statement ok
UPDATE t SET x = 99 WHERE x = 1

statement ok
ROLLBACK TO s1

query I nosort
SELECT x FROM t WHERE x = 1
----
1
