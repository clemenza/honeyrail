# AND / OR / NOT composition - see SPEC.md's Predicates section.

statement ok
CREATE TABLE people (name, dept, age)

statement ok
INSERT INTO people VALUES ('Ann', 'eng', 30)

statement ok
INSERT INTO people VALUES ('Bo', 'eng', 22)

statement ok
INSERT INTO people VALUES ('Cy', 'sales', 40)

query T rowsort
SELECT name FROM people WHERE dept = 'eng' AND age > 28
----
Ann

query T rowsort
SELECT name FROM people WHERE dept = 'sales' OR age = 22
----
Bo
Cy

query T rowsort
SELECT name FROM people WHERE NOT dept = 'eng'
----
Cy

query T rowsort
SELECT name FROM people WHERE (dept = 'eng' AND age > 28) OR dept = 'sales'
----
Ann
Cy
