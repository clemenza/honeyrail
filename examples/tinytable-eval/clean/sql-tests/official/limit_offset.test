# LIMIT / OFFSET - see SPEC.md's limit/offset section.
# Never combines LIMIT and OFFSET in the same query - their interaction
# order is the seeded defect (see golden/ once it exists).

statement ok
CREATE TABLE t (x)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

statement ok
INSERT INTO t VALUES (3)

statement ok
INSERT INTO t VALUES (4)

query I nosort
SELECT x FROM t ORDER BY x LIMIT 2
----
1
2

query I nosort
SELECT x FROM t ORDER BY x OFFSET 2
----
3
4

query I nosort
SELECT x FROM t ORDER BY x LIMIT 50
----
1
2
3
4
