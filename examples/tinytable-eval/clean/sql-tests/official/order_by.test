# ORDER BY - see SPEC.md's order_by section.
# Uses only distinct sort-key values (never tests stability/duplicate keys),
# and never combines NULLS LAST/FIRST with DESC in the same query - those
# are the two seeded defects (see golden/ once it exists).

statement ok
CREATE TABLE t (x)

statement ok
INSERT INTO t VALUES (3)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

query I nosort
SELECT x FROM t ORDER BY x
----
1
2
3

query I nosort
SELECT x FROM t ORDER BY x DESC
----
3
2
1

# NULL placement, ascending only.
statement ok
CREATE TABLE t2 (x)

statement ok
INSERT INTO t2 VALUES (2)

statement ok
INSERT INTO t2 VALUES (NULL)

statement ok
INSERT INTO t2 VALUES (1)

query I nosort
SELECT x FROM t2 ORDER BY x NULLS LAST
----
1
2
NULL

query I nosort
SELECT x FROM t2 ORDER BY x NULLS FIRST
----
NULL
1
2

# ORDER BY after a WHERE orders only the matched rows.
statement ok
CREATE TABLE people (name, age)

statement ok
INSERT INTO people VALUES ('Ann', 30)

statement ok
INSERT INTO people VALUES ('Bo', 25)

statement ok
INSERT INTO people VALUES ('Cy', 40)

statement ok
INSERT INTO people VALUES ('Di', NULL)

query T nosort
SELECT name FROM people WHERE age IS NOT NULL ORDER BY age
----
Bo
Ann
Cy
